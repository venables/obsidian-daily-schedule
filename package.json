{
  "name": "daily-schedule",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown && cp manifest.json src/styles.css dist/",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "deploy": "scripts/deploy.sh",
    "dev": "cp manifest.json src/styles.css dist/ && tsdown --watch --sourcemap --no-minify",
    "fix": "bun run lint:fix && bun run format",
    "format": "oxfmt",
    "format:check": "bun run format --check",
    "lint": "oxlint",
    "lint:fix": "bun run lint --fix --fix-suggestions",
    "lint:fixall": "bun run lint:fix --fix-dangerously",
    "lint:obsidian": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "version:bump": "bun scripts/bump-version.ts"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "ical.js": "^2.2.1",
    "moment": "2.29.4",
    "obsidian": "^1.12.3",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tsdown": "latest",
    "typescript": "^6",
    "typescript-eslint": "8.71.2",
    "valibot": "1.5.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.4.4"
}
