{
  "name": "daily-schedule",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown && cp manifest.json src/styles.css dist/",
    "check": "bun run format:check && bun run lint && bun run lint:obsidian && bun run typecheck && bun run test",
    "deploy": "scripts/deploy.sh",
    "dev": "cp manifest.json src/styles.css dist/ && tsdown --watch --sourcemap --no-minify",
    "fix": "bun run lint:fix && bun run format",
    "format": "bun fmt",
    "format:check": "bun run format --check",
    "lint": "bun lint",
    "lint:fix": "bun run lint --fix --fix-suggestions",
    "lint:fixall": "bun run lint:fix --fix-dangerously",
    "lint:obsidian": "bun lint --config eslint.config.mjs --type-aware --allow-unsupported",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version:bump": "bun scripts/bump-version.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "ical.js": "^2.2.1",
    "moment": "2.31.0",
    "obsidian": "^1.12.3",
    "tsdown": "latest",
    "typescript": "^6",
    "valibot": "1.5.0"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "packageManager": "bun@1.4.4"
}
